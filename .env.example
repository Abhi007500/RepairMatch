# ==============================================================================
# RepairMatch — Environment Variables Configuration Template
# Copy this file to '.env' and customize values for your local or production environment.
# DO NOT commit '.env' containing real secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/repairmatch
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Server Configuration
PORT=8080

# Security / JWT Configuration
# Minimum 256-bit secret key for HMAC-SHA signing (generate e.g. with `openssl rand -hex 32`)
JWT_SECRET=your_256_bit_secret_key_must_be_at_least_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP Authentication Configuration
OTP_EXPIRATION_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_ALLOW_DEMO_FALLBACK=true

# SMS Provider Configuration
# Supported providers: dev, twilio, fast2sms
SMS_PROVIDER=dev
SMS_API_KEY=your_twilio_account_sid_or_fast2sms_api_key
SMS_API_SECRET=your_twilio_auth_token
SMS_SENDER_ID=RepairMatch

# Online Payment Configuration (Razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR

# Frontend Configuration (Optional / production override)
VITE_API_BASE_URL=/api

